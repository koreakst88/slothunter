{
  "name": "slothunter",
  "version": "1.0.0",
  "description": "US Visa Slot Bot",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/index.ts",
    "dev:full": "concurrently \"npm run mock\" \"npm run dev\"",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "mock": "ts-node mock-server/index.ts",
    "test:mock": "ts-node src/test-mock.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.0",
    "axios-cookiejar-support": "^5.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "telegraf": "^4.15.3",
    "tough-cookie": "^4.1.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/tough-cookie": "^4.0.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
